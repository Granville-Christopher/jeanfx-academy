# Password for /admin. Use at least 8 characters and do not commit the real value.
ADMIN_PASSWORD=choose-a-long-password

# Signs the desk session cookie. Use at least 32 characters.
ADMIN_SECRET=choose-a-random-secret-at-least-32-chars

# Optional. When set, desk settings are stored in MongoDB database `academy`,
# collection `siteSettings`, instead of data/site-settings.json.
# MONGODB_URI=
